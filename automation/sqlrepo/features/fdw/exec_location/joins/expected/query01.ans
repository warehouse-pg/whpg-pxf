DROP TABLE
CREATE TABLE el_etl_ctas AS SELECT * FROM s_coord_s DISTRIBUTED BY (num);
SELECT 15
SELECT el_digest('SELECT * FROM el_etl_ctas') = el_digest('SELECT * FROM s_all') AS ctas_same;
 ctas_same 
